rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userDocPath());
    }

    function userDocExists() {
      return exists(userDocPath());
    }

    function userType() {
      return userDoc().data.userType;
    }

    function isAdmin() {
      return isAuthenticated() && userDocExists() && userType() == 'admin';
    }

    function isSme() {
      return isAuthenticated() && userDocExists() && userType() == 'sme';
    }

    function isYouthAgent() {
      return isAuthenticated() && userDocExists() && userType() == 'youth-agent';
    }

    // Path captures (userId) must be passed in — top-level functions cannot see match vars.
    function userCreateAllowed(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.userType in ['sme', 'youth-agent']
        && request.resource.data.get('founderAccess', false) != true
        && request.resource.data.get('suspended', false) != true
        && (
          !('verificationStatus' in request.resource.data)
          || request.resource.data.verificationStatus == 'pending'
        );
    }

    function userOwnerUpdateAllowed(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'userType',
              'role',
              'founderAccess',
              'verificationStatus',
              'verified',
              'suspended',
              'reliabilityScore',
              'missedBriefingCount',
              'completedBriefingCount',
              'acceptedBriefingCount',
              'rating',
              'totalJobs'
            ]);
    }

    // Privileged trust / role fields — client agents must not escalate these.
    // Verification escalation is Admin SDK (or isAdmin()) only.
    function agentCreateAllowed(agentId) {
      return isAuthenticated()
        && request.auth.uid == agentId
        && request.resource.data.get('founderAccess', false) != true
        && request.resource.data.get('suspended', false) != true
        && request.resource.data.get('verified', false) != true
        && (
          !('verificationStatus' in request.resource.data)
          || request.resource.data.verificationStatus == 'pending'
        );
    }

    function agentOwnerUpdateAllowed(agentId) {
      return isAuthenticated()
        && request.auth.uid == agentId
        && isYouthAgent()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'userType',
              'role',
              'founderAccess',
              'verificationStatus',
              'verified',
              'suspended',
              'reliabilityScore',
              'missedBriefingCount',
              'completedBriefingCount',
              'acceptedBriefingCount',
              'rating',
              'totalJobs'
            ]);
    }

    function agentVerificationCreateAllowed(agentId) {
      return isYouthAgent()
        && request.auth.uid == agentId
        && request.resource.data.get('adminApproved', false) != true
        && request.resource.data.get('verified', false) != true
        && (
          !('status' in request.resource.data)
          || request.resource.data.status == 'pending'
        )
        && (
          !('verificationStatus' in request.resource.data)
          || request.resource.data.verificationStatus == 'pending'
        );
    }

    function agentVerificationOwnerUpdateAllowed(agentId) {
      return isYouthAgent()
        && request.auth.uid == agentId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'status',
              'adminApproved',
              'reviewedBy',
              'reviewedAt',
              'verified',
              'verificationStatus'
            ]);
    }

    // Legacy user profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if userCreateAllowed(userId);
      allow update: if userOwnerUpdateAllowed(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // TenderBriefing platform — procurement intelligence
    match /tenderBriefings/{tenderId} {
      allow read: if isAuthenticated() && (
        isAdmin()
        || !('visibility' in resource.data) || resource.data.visibility != 'private'
        || (isSme() && resource.data.ownerUid == request.auth.uid)
      );
      allow write: if isAdmin();
    }

    // Privileged payment / assignment / lifecycle fields — Admin SDK only.
    function attendancePrivilegedKeysUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'paymentStatus',
          'paymentProvider',
          'paymentAmount',
          'quotedFee',
          'currency',
          'paymentReference',
          'payfastPaymentId',
          'payfastRedirectUrl',
          'yocoCheckoutId',
          'yocoRedirectUrl',
          'paidAt',
          'paymentFailureReason',
          'agentId',
          'assignedAgentId',
          'agentName',
          'status',
          'smeId',
          'notifiedAgents',
          'acceptedAt',
          'declines'
        ]);
    }

    match /attendanceRequests/{requestId} {
      allow create: if isSme()
        && request.resource.data.smeId == request.auth.uid
        && request.resource.data.get('paymentStatus', 'pending') in ['pending', 'not_required']
        && request.resource.data.get('status', 'pending') == 'pending'
        && !('agentId' in request.resource.data
          && request.resource.data.agentId != null
          && request.resource.data.agentId != '');
      allow read: if isAdmin()
        || (isSme() && resource.data.smeId == request.auth.uid)
        || (isYouthAgent() && (
          resource.data.agentId == request.auth.uid
          || resource.data.get('assignedAgentId', '') == request.auth.uid
          || ('notifiedAgents' in resource.data
            && request.auth.uid in resource.data.notifiedAgents)
        ));
      // Client updates cannot escalate payment, assignment, or workflow status.
      // Lifecycle mutations go through Admin SDK APIs.
      allow update: if isAdmin()
        || (isSme()
          && resource.data.smeId == request.auth.uid
          && attendancePrivilegedKeysUnchanged())
        || (isYouthAgent()
          && (
            resource.data.agentId == request.auth.uid
            || resource.data.get('assignedAgentId', '') == request.auth.uid
          )
          && attendancePrivilegedKeysUnchanged());
    }

    match /briefingReports/{reportId} {
      allow create: if isYouthAgent()
        && request.resource.data.agentId == request.auth.uid;
      allow read: if isAdmin()
        || (isYouthAgent() && resource.data.agentId == request.auth.uid)
        || (isSme() && resource.data.smeId == request.auth.uid);
    }

    match /briefingIntelligenceReports/{reportId} {
      allow create: if isYouthAgent()
        && request.resource.data.agentId == request.auth.uid;
      allow read: if isAdmin()
        || (isYouthAgent() && resource.data.agentId == request.auth.uid)
        || (isSme() && resource.data.smeId == request.auth.uid);
      allow update: if isAdmin()
        || (isYouthAgent() && resource.data.agentId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'smeId',
              'reportId',
              'deliveredAt',
              'pdfStorageRef',
              'deliveryEmailId',
              'status',
              'reportContent',
              'transcription',
              'meetingMinutes',
              'meetingMinutesSummary',
              'meetingMinutesVersionId',
              'meetingMinutesPromptVersion',
              'reportGenerationStatus',
              'finalizedAt',
              'draftReadyAt',
              'processingStartedAt',
              'processingAttempts',
              'lastError',
            ]));
    }

    // Async transcription jobs — Admin SDK only (no client access).
    match /briefingTranscriptionJobs/{jobId} {
      allow read, write: if false;
    }

    // Durable briefing transcripts — Admin SDK only (served via authenticated admin APIs).
    match /briefingTranscripts/{transcriptId} {
      allow read, write: if false;
    }

    // Meeting-minutes report jobs — Admin SDK only.
    match /briefingReportJobs/{jobId} {
      allow read, write: if false;
    }

    // Versioned meeting-minutes reports — Admin SDK only.
    match /briefingReportVersions/{versionId} {
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Distributed rate-limit buckets — Admin SDK only
    match /rateLimitBuckets/{bucketId} {
      allow read, write: if false;
    }

    // First-party product analytics — clients may create own events only.
    // Reads are Admin SDK only (Founder APIs). No client list/query of analytics.
    match /productEvents/{eventId} {
      allow create: if isAuthenticated()
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.keys().hasAll(['eventId', 'eventName', 'actorUserId', 'timestamp'])
        && request.resource.data.actorUserId is string
        && request.resource.data.eventName is string;
      allow read, update, delete: if false;
    }

    match /userActivitySummaries/{uid} {
      // Own summary readable for optional UX; writes only via Admin SDK.
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    match /founderAccessLogs/{logId} {
      allow read, write: if false;
    }

    match /founderDailySummaries/{docId} {
      allow read, write: if false;
    }

    match /syncStatus/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    match /workflowEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dispatchEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /executiveMetrics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /slaBreaches/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /agentPerformanceSnapshots/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /workflowFailures/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /workflowAutomationState/{docId} {
      allow read, write: if false;
    }

    // Automation control-plane records are only exposed through founder-authenticated
    // server routes; clients never access leases or run metadata directly.
    match /automationRuns/{runId} {
      allow read, write: if false;
    }

    match /automationLeases/{leaseId} {
      allow read, write: if false;
    }

    match /pilotLeads/{leadId} {
      allow read, write: if isAdmin();
    }

    match /pilotOutreach/{outreachId} {
      allow read, write: if isAdmin();
    }

    match /pilotTasks/{taskId} {
      allow read, write: if isAdmin();
    }

    match /pilotFeedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    match /gpsAttendanceLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isYouthAgent();
      allow write: if false;
    }

    match /dispatchTracking/{docId} {
      allow read: if isAdmin() || isYouthAgent();
      allow write: if isAdmin();
    }

    match /fraudAlerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /financePayouts/{payoutId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /youthAgentPayouts/{payoutId} {
      allow read: if isAdmin()
        || (isYouthAgent() && resource.data.youthAgentUid == request.auth.uid);
      allow write: if false;
    }

    match /financeInvoices/{invoiceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /financeTransactions/{txId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /aiTenderInsights/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /aiBriefingInsights/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /agentVerification/{agentId} {
      allow read: if isAdmin() || (isYouthAgent() && request.auth.uid == agentId);
      allow create: if agentVerificationCreateAllowed(agentId) || isAdmin();
      allow update: if agentVerificationOwnerUpdateAllowed(agentId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /operationalIncidents/{incidentId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow write: if false;
    }

    match /agents/{agentId} {
      allow read: if isAuthenticated();
      allow create: if agentCreateAllowed(agentId);
      allow update: if isAdmin() || agentOwnerUpdateAllowed(agentId);
      allow delete: if isAdmin();
    }

    match /smes/{smeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == smeId;
      allow update: if isAdmin() || (isSme() && request.auth.uid == smeId);
      allow delete: if isAdmin();
    }

  match /smeWorkspace/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId && isSme();

      match /savedTenders/{tenderId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId && isSme();
      }

      match /trackedTenders/{tenderId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId && isSme();
      }

      match /watchedDepartments/{departmentId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId && isSme();
      }

      match /watchedProvinces/{provinceId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId && isSme();
      }
    }

    // Legacy collections (TenderConnect)
    match /tenders/{tenderId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /scraped_tenders/{tenderId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (resource.data.entrepreneurId == request.auth.uid ||
         resource.data.connectorId == request.auth.uid ||
         resource.data.smeId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.entrepreneurId == request.auth.uid ||
         resource.data.connectorId == request.auth.uid ||
         resource.data.smeId == request.auth.uid);
    }

    match /submissions/{submissionId} {
      allow read, write: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated()
        && (resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
          || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && resource.data.raterId == request.auth.uid;
    }

    match /scraping_jobs/{jobId} {
      allow read, write: if isAdmin();
    }

    match /connectorAvailability/{docId} {
      allow read: if isAuthenticated();
      allow write: if isYouthAgent() || isAdmin();
    }

    match /mobileSessions/{sessionId} {
      allow read: if isAdmin() || (isYouthAgent() && resource.data.agentId == request.auth.uid);
      allow create: if isYouthAgent() && request.resource.data.agentId == request.auth.uid;
      allow update: if isAdmin() || (isYouthAgent() && resource.data.agentId == request.auth.uid);
    }

    match /mobileSyncQueue/{itemId} {
      allow read: if isAdmin() || (isYouthAgent() && resource.data.agentId == request.auth.uid);
      allow create: if isYouthAgent() && request.resource.data.agentId == request.auth.uid;
      allow update: if isAdmin() || (isYouthAgent() && resource.data.agentId == request.auth.uid);
    }

    match /mobileTelemetry/{eventId} {
      allow read: if isAdmin() || (isYouthAgent() && resource.data.agentId == request.auth.uid);
      allow create: if isYouthAgent() && request.resource.data.agentId == request.auth.uid;
    }

    match /agentLocationPings/{pingId} {
      allow read: if isAdmin() || (isYouthAgent() && resource.data.agentId == request.auth.uid);
      allow create: if isYouthAgent() && request.resource.data.agentId == request.auth.uid;
    }

    match /procurementSources/{sourceId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /aiProcurementExtraction/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /procurementGraphMetrics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /procurementSourceLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ingestedProcurementEmails/{emailId} {
      allow read: if isAdmin()
        || (isSme() && resource.data.forwardedByUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSme() && request.resource.data.forwardedByUid == request.auth.uid);
      allow update: if isAdmin()
        || (isSme() && resource.data.forwardedByUid == request.auth.uid);
    }

    match /dispatchAutomationLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /attendanceRiskPredictions/{docId} {
      allow read: if isAdmin()
        || (isSme() && resource.data.requestId != null);
      allow write: if false;
    }

    match /rfqTriageResults/{docId} {
      allow read: if isAdmin()
        || (isSme() && resource.data.forwardedByUid == request.auth.uid);
      allow write: if false;
    }

    match /procurementWatchlists/{smeUid} {
      allow read: if isAdmin() || (isSme() && request.auth.uid == smeUid);
      allow write: if false;
    }

    match /submissionReadinessReports/{docId} {
      allow read: if isAdmin()
        || (isSme() && docId.matches('^' + request.auth.uid + '(_|$)'));
      allow write: if false;
    }

    // SME checklist / bid-decision progress — never mutate source tender truth.
    match /smeTenderIntelligence/{smeId} {
      allow read, write: if isAdmin()
        || (isSme() && request.auth.uid == smeId);
      match /tenders/{tenderId} {
        // Reads must not require request.resource (write-only); cross-tenant denied.
        allow read: if isAdmin()
          || (isSme() && request.auth.uid == smeId);
        allow write: if isAdmin()
          || (isSme() && request.auth.uid == smeId
            && !request.resource.data.keys().hasAny(['paymentStatus', 'userType', 'role']));
      }
    }

    match /dailyProcurementBriefs/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /workflowEscalations/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /executiveBriefingSummaries/{docId} {
      allow read: if isAdmin() || isSme();
      allow write: if false;
    }

    match /procurementMemory/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pricingOptimizationLogs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /fraudAutomationInsights/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /procurementForecasts/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /calendarIntelligenceInsights/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.requesterUid == request.auth.uid);
      allow write: if false;
    }

    match /enterpriseFieldOps/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Youth Agent Workspace v1 — client reads scoped; privileged writes via Admin SDK
    match /agentWorkspaceAuditEvents/{eventId} {
      allow read: if isAdmin()
        || (isYouthAgent() && resource.data.actorUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /fieldReportDrafts/{draftId} {
      allow read: if isAdmin()
        || (isYouthAgent() && resource.data.agentId == request.auth.uid)
        || (isSme() && resource.data.smeId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /assignmentMessages/{messageId} {
      allow read: if isAdmin()
        || (isAuthenticated()
          && (resource.data.senderId == request.auth.uid
            || resource.data.recipientId == request.auth.uid));
      allow create, update, delete: if false;
    }

    match /agentEarningsLedger/{entryId} {
      allow read: if isAdmin()
        || (isYouthAgent() && resource.data.agentId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /agentWorkspaceAnalytics/{eventId} {
      allow read: if isAdmin()
        || (isYouthAgent() && resource.data.agentId == request.auth.uid);
      allow create, update, delete: if false;
    }
  }
}
