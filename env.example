# Public site URL (canonical / OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.tenderbriefing.co.za

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Stripe — RETIRED (PayFast is the sole payment provider)
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=

# Admin Configuration
ADMIN_EMAIL=admin@tenderconnect.com

# TenderBriefing platform storage: json (local) | firestore (production)
STORAGE_ADAPTER=json
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
SYNC_SECRET=change-this-secure-value
# Optional: override official eTenders OCDS base (default ocds-api.etenders.gov.za)
# OCDS_API_BASE=https://ocds-api.etenders.gov.za/api/OCDSReleases
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Platform integrations (see docs/API_INTEGRATIONS.md) ---

# Customer-facing WhatsApp chat link (UI icon links). Default: https://wa.me/27720708467
NEXT_PUBLIC_WHATSAPP_SUPPORT=https://wa.me/27720708467

# Contact form emails (support@ + submitter ack) use lib/services/gmail.ts.
# Ticket creation still works if mail is not configured; check Cloud Run logs for [supportEmail].
# Needs Gmail API + a service account that can send as support@tenderbriefing.co.za
# (domain-wide delegation / subject), typically via GOOGLE_CALENDAR_CLIENT_EMAIL +
# GOOGLE_CALENDAR_PRIVATE_KEY already used by the Gmail service.
# Optional OAuth path: GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET (+ refresh token wiring).

# Resend — welcome emails after SME / Youth Agent registration (server only).
# Local: set RESEND_API_KEY below. Production: Cloud Run mounts GSM secret `Resend_API`
# as RESEND_API_KEY (see cloudbuild.yaml --set-secrets). Missing key → skip send.
RESEND_API_KEY=
# Optional from address (must use a verified domain). Not stored in Secret Manager.
# Default: TenderBriefing <hello@tenderbriefing.co.za>
RESEND_FROM_EMAIL=TenderBriefing <hello@tenderbriefing.co.za>

# Twilio WhatsApp (production — Secret Manager on Cloud Run)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Business API (optional legacy integration)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# Google Maps Platform
GOOGLE_MAPS_API_KEY=

# PayFast Payments (server only — never expose keys to the browser)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=live
# Optional non-secret: merchant profile email for same-account checkout guard
# PAYFAST_MERCHANT_EMAIL=
NEXT_PUBLIC_ATTENDANCE_FEE_CENTS=34900
NEXT_PUBLIC_ATTENDANCE_FEE_LABEL=R349.00

# Firebase Storage (server — also set NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET)
FIREBASE_STORAGE_BUCKET=

# Google Analytics 4 (browser)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Founder User Intelligence — fail-closed feature flag (founder_user_intelligence)
# Set both to true only for approved founder pilot. Ordinary admins remain blocked.
FOUNDER_USER_INTELLIGENCE_ENABLED=false
NEXT_PUBLIC_FOUNDER_USER_INTELLIGENCE=false
FOUNDER_EMAIL_ALLOWLIST=info@tenderbriefing.co.za

# Google Search Console (HTML tag verification content value)
GOOGLE_SITE_VERIFICATION=
# Google Search Console HTML tag: paste the content value only (from meta name="google-site-verification").

# Google Calendar API (future)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Graph (future)
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_TENANT_ID=
