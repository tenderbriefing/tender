# gcloud builds submit uses .gcloudignore (not .dockerignore).
# Do NOT ignore Dockerfile — Cloud Build needs it in the upload.
# Keep .dockerignore so `docker build` still excludes heavy paths.

node_modules
npm-debug.log
.next
.git
.gitignore
.env
.env.*
!.env.local.example
service-account.json
**/service-account*.json
backend/data/*.json
!backend/data/.gitkeep
backend/logs/*.jsonl
!backend/logs/.gitkeep
README.md
*.md
.DS_Store
.firebase
coverage
.cursor
mobile-agent-app
