# TenderBriefing — Firebase project: tenderbriefing (tenderbriefing-34679)

# Storage: json (local) | firestore (production)
STORAGE_ADAPTER=firestore
FIREBASE_PROJECT_ID=tenderbriefing-34679
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional: inline service account JSON (single line) instead of file
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Scheduled sync auth (required in production for POST /api/sync/run)
SYNC_SECRET=change-this-secure-value
# Optional OCDS base override if a documented fallback exists
# OCDS_API_BASE=https://ocds-api.etenders.gov.za/api/OCDSReleases
# Optional bounded automation overrides (validated server-side).
AUTOMATION_REQUEST_TIMEOUT_MS=300000
AUTOMATION_SAFETY_MARGIN_MS=20000
AUTOMATION_BUDGET_MS=240000
# memory is test-only; production derives Firestore from STORAGE_ADAPTER.
# AUTOMATION_STATE_ADAPTER=memory

# OpenAI (optional — rule-based summaries when empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public site URL (SEO, sitemap, OpenGraph). Cloud Run fallback remains active.
NEXT_PUBLIC_SITE_URL=https://www.tenderbriefing.co.za

# Firebase client (browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tenderbriefing-34679.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tenderbriefing-34679
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tenderbriefing-34679.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=9058655644
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In uses the Firebase client config above (GoogleAuthProvider).
# Ensure Google provider is enabled in Identity Platform / Firebase Auth.
# Authorised domains: www.tenderbriefing.co.za, tenderbriefing.co.za, localhost
# See docs/GOOGLE_SIGNIN.md

# Stripe — RETIRED (do not use; PayFast is the sole payment provider)
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=

# Integrations — docs/API_INTEGRATIONS.md
# Customer-facing WhatsApp chat (UI). Not the Twilio sender number.
NEXT_PUBLIC_WHATSAPP_SUPPORT=https://wa.me/27720708467
# Contact form → support@ email uses Gmail service (see env.example). Tickets still persist if mail fails.

# Resend — SME / Youth Agent welcome emails (server only; skip send if unset).
# Production mounts GSM secret `Resend_API` → RESEND_API_KEY (cloudbuild.yaml).
RESEND_API_KEY=
# Optional plain env (not a GSM secret); default TenderBriefing <hello@tenderbriefing.co.za>
RESEND_FROM_EMAIL=TenderBriefing <hello@tenderbriefing.co.za>

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
GOOGLE_MAPS_API_KEY=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=live
# Merchant PayFast profile email — omit buyer email_address when it matches (same-account guard)
PAYFAST_MERCHANT_EMAIL=info@tenderbriefing.co.za
NEXT_PUBLIC_ATTENDANCE_FEE_CENTS=24900
NEXT_PUBLIC_ATTENDANCE_FEE_LABEL=R249.00
FIREBASE_STORAGE_BUCKET=tenderbriefing-34679.firebasestorage.app
FCM_SERVER_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_TENANT_ID=

# Founder User Intelligence (fail-closed — default off)
FOUNDER_USER_INTELLIGENCE_ENABLED=false
NEXT_PUBLIC_FOUNDER_USER_INTELLIGENCE=false
# Founder allowlist (access control + RFQ ingest ops email via Resend)
FOUNDER_EMAIL_ALLOWLIST=info@tenderbriefing.co.za
# Founder Dashboard V2 (defaults on). Set both to false to restore legacy founder home.
# FOUNDER_DASHBOARD_V2=false
# NEXT_PUBLIC_FOUNDER_DASHBOARD_V2=false

# Google Continue / Sign-In UI (fail-closed — default off in production)
# Set true locally to exercise Google auth; production Cloud Build ships false.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false


# Procurement Intelligence Phase 1 (fail-closed)
# ENABLED=false means not globally enabled; non-empty PILOT_UIDS still grants those UIDs access.
PROCUREMENT_INTELLIGENCE_ENABLED=false
# Advisory client mirror only — pilots discover UI via authenticated API 200.
NEXT_PUBLIC_PROCUREMENT_INTELLIGENCE_ENABLED=false
# Comma-separated approved Firebase Auth UIDs. Empty + ENABLED=false = deny-all.
# Production: GSM secret procurement-intelligence-pilot-uids (never commit real UIDs).
PROCUREMENT_INTELLIGENCE_PILOT_UIDS=
